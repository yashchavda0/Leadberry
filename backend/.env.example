# CRM entrypoint: app.main:create_app --factory, port 8000.
# Use restricted PostgreSQL roles, never the migrator or administrator.
# DATABASE_URL and AUTH_DATABASE_URL must target the same database with distinct users.
# The local helper reads ignored runtime/identity secrets and supplies both URLs.
# Leave database URLs unset here until your PostgreSQL server and roles are provisioned.
APP_ENVIRONMENT=development
SESSION_HOURS=12
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
DB_POOL_SIZE=6
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000

# From the project root, run scripts\Invoke-LocalBackend.ps1 -Action Run.
# PostgreSQL is available at 127.0.0.1:55432; the frontend proxies to port 8000.
